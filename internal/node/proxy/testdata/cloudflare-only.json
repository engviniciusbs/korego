{
  "admin": {
    "listen": "127.0.0.1:2019",
    "config": {
      "persist": false
    }
  },
  "apps": {
    "http": {
      "servers": {
        "korego_http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "api.exemplo.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "delete": [
                      "Server",
                      "Via"
                    ],
                    "deferred": true
                  }
                },
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:3"
                            }
                          ],
                          "headers": {
                            "request": {
                              "set": {
                                "X-Real-IP": [
                                  "{http.request.remote.host}"
                                ]
                              }
                            }
                          }
                        }
                      ],
                      "terminal": true
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "exemplo.com"
                  ],
                  "not": [
                    {
                      "remote_ip": {
                        "ranges": [
                          "173.245.48.0/20",
                          "103.21.244.0/22",
                          "2400:cb00::/32"
                        ]
                      }
                    }
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "delete": [
                      "Server",
                      "Via"
                    ],
                    "deferred": true
                  }
                },
                {
                  "handler": "static_response",
                  "status_code": 403
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "exemplo.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "delete": [
                      "Server",
                      "Via"
                    ],
                    "deferred": true
                  }
                },
                {
                  "handler": "static_response",
                  "status_code": 308,
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"

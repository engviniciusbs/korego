{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "servers": {
        "korego_http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "deferred": true,
                    "delete": [
                      "Server",
                      "Via"
                    ]
                  }
                },
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}"
                    ]
                  },
                  "status_code": 308
                }
              ],
              "match": [
                {
                  "host": [
                    "loja.exemplo.net"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "delete": [
                      "Server",
                      "Via"
                    ],
                    "deferred": true
                  }
                },
                {
                  "body": "Domínio não configurado no KoreGO.",
                  "handler": "static_response",
                  "status_code": 404
                }
              ],
              "terminal": true
            }
          ],
          "errors": {
            "routes": [
              {
                "handle": [
                  {
                    "handler": "headers",
                    "response": {
                      "delete": [
                        "Server",
                        "Via"
                      ],
                      "deferred": true
                    }
                  },
                  {
                    "handler": "static_response",
                    "status_code": "{http.error.status_code}"
                  }
                ],
                "terminal": true
              }
            ]
          }
        },
        "korego_https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "deferred": true,
                    "delete": [
                      "Server",
                      "Via"
                    ],
                    "set": {
                      "Permissions-Policy": [
                        "camera=(), microphone=(), geolocation=()"
                      ],
                      "Referrer-Policy": [
                        "strict-origin-when-cross-origin"
                      ],
                      "Strict-Transport-Security": [
                        "max-age=31536000"
                      ],
                      "X-Content-Type-Options": [
                        "nosniff"
                      ]
                    }
                  }
                },
                {
                  "encodings": {
                    "gzip": {},
                    "zstd": {}
                  },
                  "handler": "encode",
                  "prefer": [
                    "zstd",
                    "gzip"
                  ]
                },
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "match": [
                        {
                          "path": [
                            "/api/v2"
                          ]
                        }
                      ],
                      "handle": [
                        {
                          "handler": "static_response",
                          "status_code": 308,
                          "headers": {
                            "Location": [
                              "/api/v2/{http.request.uri.prefixed_query}"
                            ]
                          }
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "flush_interval": -1,
                          "handler": "reverse_proxy",
                          "headers": {
                            "request": {
                              "set": {
                                "X-Real-IP": [
                                  "{http.request.remote.host}"
                                ]
                              }
                            }
                          },
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:20003"
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/api/v2/*"
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "match": [
                        {
                          "path": [
                            "/api"
                          ]
                        }
                      ],
                      "handle": [
                        {
                          "handler": "static_response",
                          "status_code": 308,
                          "headers": {
                            "Location": [
                              "/api/{http.request.uri.prefixed_query}"
                            ]
                          }
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "request_body",
                          "max_size": 1048576
                        },
                        {
                          "handler": "reverse_proxy",
                          "headers": {
                            "request": {
                              "set": {
                                "X-Real-IP": [
                                  "{http.request.remote.host}"
                                ]
                              }
                            }
                          },
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:20002"
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/api/*"
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "headers": {
                            "request": {
                              "set": {
                                "X-Real-IP": [
                                  "{http.request.remote.host}"
                                ]
                              }
                            }
                          },
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:20001"
                            }
                          ]
                        }
                      ],
                      "terminal": true
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "loja.exemplo.net"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "delete": [
                      "Server",
                      "Via"
                    ],
                    "deferred": true
                  }
                },
                {
                  "body": "Domínio não configurado no KoreGO.",
                  "handler": "static_response",
                  "status_code": 404
                }
              ],
              "terminal": true
            }
          ],
          "errors": {
            "routes": [
              {
                "match": [
                  {
                    "host": [
                      "loja.exemplo.net"
                    ]
                  }
                ],
                "handle": [
                  {
                    "handler": "headers",
                    "response": {
                      "deferred": true,
                      "delete": [
                        "Server",
                        "Via"
                      ],
                      "set": {
                        "Permissions-Policy": [
                          "camera=(), microphone=(), geolocation=()"
                        ],
                        "Referrer-Policy": [
                          "strict-origin-when-cross-origin"
                        ],
                        "Strict-Transport-Security": [
                          "max-age=31536000"
                        ],
                        "X-Content-Type-Options": [
                          "nosniff"
                        ]
                      }
                    }
                  },
                  {
                    "handler": "static_response",
                    "status_code": "{http.error.status_code}"
                  }
                ],
                "terminal": true
              },
              {
                "handle": [
                  {
                    "handler": "headers",
                    "response": {
                      "delete": [
                        "Server",
                        "Via"
                      ],
                      "deferred": true
                    }
                  },
                  {
                    "handler": "static_response",
                    "status_code": "{http.error.status_code}"
                  }
                ],
                "terminal": true
              }
            ]
          }
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "subjects": [
              "loja.exemplo.net"
            ]
          }
        ]
      }
    }
  }
}

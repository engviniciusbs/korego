{
  "admin": {
    "listen": "127.0.0.1:2019",
    "config": {
      "persist": false
    }
  },
  "apps": {
    "http": {
      "servers": {
        "korego_http": {
          "errors": {
            "routes": [
              {
                "handle": [
                  {
                    "handler": "headers",
                    "response": {
                      "deferred": true,
                      "delete": [
                        "Server",
                        "Via"
                      ]
                    }
                  },
                  {
                    "handler": "static_response",
                    "status_code": "{http.error.status_code}"
                  }
                ],
                "terminal": true
              }
            ]
          },
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "deferred": true,
                    "delete": [
                      "Server",
                      "Via"
                    ]
                  }
                },
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "static_response",
                          "headers": {
                            "Location": [
                              "/app/{http.request.uri.prefixed_query}"
                            ]
                          },
                          "status_code": 308
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/app"
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "handler": "rewrite",
                                  "strip_path_prefix": "/app"
                                }
                              ],
                              "terminal": false
                            },
                            {
                              "handle": [
                                {
                                  "handler": "headers",
                                  "response": {
                                    "deferred": true,
                                    "set": {
                                      "Cache-Control": [
                                        "public, max-age=31536000, immutable"
                                      ]
                                    }
                                  }
                                },
                                {
                                  "handler": "file_server",
                                  "hide": [
                                    ".git",
                                    ".env*"
                                  ],
                                  "root": "/var/www/app/current"
                                }
                              ],
                              "match": [
                                {
                                  "path": [
                                    "/assets/*"
                                  ]
                                }
                              ],
                              "terminal": true
                            },
                            {
                              "handle": [
                                {
                                  "handler": "rewrite",
                                  "uri": "{http.matchers.file.relative}"
                                }
                              ],
                              "match": [
                                {
                                  "file": {
                                    "root": "/var/www/app/current",
                                    "try_files": [
                                      "{http.request.uri.path}",
                                      "/index.html"
                                    ]
                                  }
                                }
                              ],
                              "terminal": false
                            },
                            {
                              "handle": [
                                {
                                  "handler": "headers",
                                  "response": {
                                    "deferred": true,
                                    "set": {
                                      "Cache-Control": [
                                        "no-cache"
                                      ]
                                    }
                                  }
                                }
                              ],
                              "match": [
                                {
                                  "path": [
                                    "/",
                                    "/index.html"
                                  ]
                                }
                              ],
                              "terminal": false
                            },
                            {
                              "handle": [
                                {
                                  "handler": "file_server",
                                  "hide": [
                                    ".git",
                                    ".env*"
                                  ],
                                  "root": "/var/www/app/current"
                                }
                              ],
                              "terminal": true
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/app/*"
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "headers": {
                            "request": {
                              "set": {
                                "X-Real-IP": [
                                  "{http.request.remote.host}"
                                ]
                              }
                            }
                          },
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:8091"
                            }
                          ]
                        }
                      ],
                      "terminal": true
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "exemplo.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "deferred": true,
                    "delete": [
                      "Server",
                      "Via"
                    ]
                  }
                },
                {
                  "body": "Domínio não configurado no KoreGO.",
                  "handler": "static_response",
                  "status_code": 404
                }
              ],
              "terminal": true
            }
          ]
        },
        "korego_https": {
          "automatic_https": {
            "disable_redirects": true
          },
          "errors": {
            "routes": [
              {
                "handle": [
                  {
                    "handler": "headers",
                    "response": {
                      "deferred": true,
                      "delete": [
                        "Server",
                        "Via"
                      ]
                    }
                  },
                  {
                    "handler": "static_response",
                    "status_code": "{http.error.status_code}"
                  }
                ],
                "terminal": true
              }
            ]
          },
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "deferred": true,

                                  ]
                                }
                              ],
                              "terminal": false
                            },
                            {
                              "handle": [
                                {
                                  "handler": "file_server",
                                  "hide": [
                                    ".git",
                                    ".env*"
                                  ],
                                  "root": "/var/www/app/current"
                                }
                              ],
                              "terminal": true
                            }
                          ]
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/app/*"
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "headers": {
                            "request": {
                              "set": {
                                "X-Real-IP": [
                                  "{http.request.remote.host}"
                                ]
                              }
                            }
                          },
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:8091"
                            }
                          ]
                        }
                      ],
                      "terminal": true
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "exemplo.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "deferred": true,
                    "delete": [
                      "Server",
                      "Via"
                    ]
                  }
                },
                {
                  "body": "Domínio não configurado no KoreGO.",
                  "handler": "static_response",
                  "status_code": 404
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "subjects": [
              "exemplo.com"
            ]
          }
        ]
      }
    }
  }
}

                          "headers": {
                            "Location": [
                              "/app/{http.request.uri.prefixed_query}"
                            ]
                          },
                          "status_code": 308
                        }
                      ],
                      "match": [
                        {
                          "path": [
                            "/app"
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "handler": "rewrite",
                                  "strip_path_prefix": "/app"
                                }
                              ],
                              "terminal": false
                            },
                            {
                              "handle": [
                                {
                                  "handler": "headers",
                                  "response": {
                                    "deferred": true,
                                    "set": {
                                      "Cache-Control": [
                                        "public, max-age=31536000, immutable"
                                      ]
                                    }
                                  }
                                },
                                {
                                  "handler": "file_server",
                                  "hide": [
                                    ".git",
                                    ".env*"
                                  ],
                                  "root": "/var/www/app/current"
                                }
                              ],
                              "match": [
                                {
                                  "path": [
                                    "/assets/*"
                                  ]
                                }
                              ],
                              "terminal": true
                            },
                            {
                              "handle": [
                                {
                                  "handler": "rewrite",
                                  "uri": "{http.matchers.file.relative}"
                                }
                              ],
                              "match": [
                                {
                                  "file": {

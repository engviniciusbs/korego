                      "Via"
                    ],
                    "deferred": true
                  }
                },
                {
                  "handler": "static_response",
                  "status_code": 404,
                  "body": "Domínio não configurado no KoreGO."
                }
              ],
              "terminal": true
            }
          ],
          "errors": {
            "routes": [
              {
                "handle": [
                  {
                    "handler": "headers",
                    "response": {
                      "delete": [
                        "Server",
                        "Via"
                      ],
                      "deferred": true
                    }
                  },
                  {
                    "handler": "static_response",
                    "status_code": "{http.error.status_code}"
                  }
                ],
                "terminal": true
              }
            ]
          }
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "subjects": [
              "api.exemplo.com",
              "app.exemplo.com",
              "exemplo.com",
              "www.exemplo.com"
            ]
          }
        ]
      }
    }
  }
}

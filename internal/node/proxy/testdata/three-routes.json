{
  "admin": {
    "listen": "127.0.0.1:2019",
    "config": {
      "persist": false
    }
  },
  "apps": {
    "http": {
      "servers": {
        "korego_https": {
          "listen": [
            ":443"
          ],
          "automatic_https": {
            "disable_redirects": true
          },
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "api.exemplo.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "delete": [
                      "Server",
                      "Via"
                    ],
                    "deferred": true
                  }
                },
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:20002"
                            }
                          ],
                          "headers": {
                            "request": {
                              "set": {
                                "X-Real-IP": [
                                  "{http.request.remote.host}"
                                ]
                              }
                            }
                          }
                        }
                      ],
                      "terminal": true
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "app.exemplo.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "delete": [
                      "Server",
                      "Via"
                    ],
                    "deferred": true
                  }
                },
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:20001"
                            }
                          ],
                          "headers": {
                            "request": {
                              "set": {
                                "X-Real-IP": [
                                  "{http.request.remote.host}"
                                ]
                              }
                            }
                          }
                        }
                      ],
                      "terminal": true
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "exemplo.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "delete": [
                      "Server",
                      "Via"
                    ],
                    "deferred": true
                  }
                },
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "127.0.0.1:20003"
                            }
                          ],
                          "headers": {
                            "request": {
                              "set": {
                                "X-Real-IP": [
                                  "{http.request.remote.host}"
                                ]
                              }
                            }
                          }
                        }
                      ],
                      "terminal": true
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "www.exemplo.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "delete": [
                      "Server",
                      "Via"
                    ],
                    "deferred": true
                  }
                },
                {
                  "handler": "static_response",
                  "status_code": 308,
                  "headers": {
                    "Location": [
                      "https://exemplo.com{http.request.uri}"
                    ]
                  }
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "headers",
                  "response": {
                    "delete": [
                      "Server",
                      "Via"
                    ],
                    "deferred": true
                  }
                },
                {
                  "handler": "static_response",
                  "status_code": 404,
                  "body": "Domínio não configurado no KoreGO."
                }
              ],
              "terminal": true
            }
          ],
          "errors": {
            "routes": [
              {
                "handle": [
                  {
                    "handler": "headers",
                    "response": {
                      "delete": [
                        "Server",
                        "Via"
                      ],
                      "deferred": true
                    }
                  },
                  {
                    "handler": "static_response",
                    "status_code": "{http.error.status_code}"
                  }
                ],
                "terminal": true
              }
            ]
          }
        },
